<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AskMeFirst.MgmtUi.ViewModels"
             x:Class="AskMeFirst.MgmtUi.Views.AreaDetailView"
             x:DataType="vm:AreaDetailViewModel"
             x:CompileBindings="True">

    <Border Padding="20"
            BorderBrush="{DynamicResource Token.Border.Default}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource Token.Surface.Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="← Back"
                        Command="{Binding BackCommand}"
                        Padding="10,4"
                        Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding BodyMessage}"
                       FontSize="13"
                       Foreground="{DynamicResource Token.Text.Dim}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
