<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AskMeFirst.MgmtUi.ViewModels"
             x:Class="AskMeFirst.MgmtUi.Views.AreaDetailView"
             x:DataType="vm:AreaDetailViewModel"
             x:CompileBindings="True">

    <Border Padding="20"
            BorderBrush="{DynamicResource Token.Border.Default}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource Token.Surface.Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="← Back"
                        Command="{Binding BackCommand}"
                        Padding="10,4"
                        Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="+ Add"
                        DockPanel.Dock="Right"
                        Command="{Binding AddCommand}"
                        Padding="12,4"
                        IsVisible="{Binding SupportsAdd}" />
            </DockPanel>

            <TextBlock Text="{Binding Placeholder}"
                       IsVisible="{Binding !HasRows}"
                       FontSize="13"
                       Foreground="{DynamicResource Token.Text.Dim}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

            <StackPanel IsVisible="{Binding HasExtraRows}"
                        Margin="0,16,0,0">
                <TextBlock Text="{Binding ExtraSectionTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.Text.Dim}"
                           Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="240">
                    <ItemsControl ItemsSource="{Binding ExtraRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetectedBrowserRowViewModel">
                                <Border Margin="0,0,0,8"
                                        Padding="12,8"
                                        BorderBrush="{DynamicResource Token.Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="{DynamicResource Token.Surface.Elevated}">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Token.Text.Dim}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ExecutablePath}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="+ Add to config"
                                                Command="{Binding AddToConfigCommand}"
                                                Padding="10,4"
                                                IsVisible="{Binding HasAddButton}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <ScrollViewer IsVisible="{Binding HasRows}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.DataTemplates>

                        <DataTemplate DataType="vm:RuleRowViewModel">
                            <Border Margin="0,0,0,12" Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Priority" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Priority, Mode=TwoWay}" Minimum="0" Maximum="10000" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="URL regex" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UrlRegex, Mode=TwoWay}" PlaceholderText="optional" />
                                    </Grid>
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource Token.Danger.Default}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Discard" Command="{Binding DiscardCommand}" Padding="10,4" />
                                        <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:BrowserRowViewModel">
                            <Border Margin="0,0,0,12" Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Executable" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Executable, Mode=TwoWay}" PlaceholderText="auto" />
                                    </Grid>
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource Token.Danger.Default}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Discard" Command="{Binding DiscardCommand}" Padding="10,4" />
                                        <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:ProfileRowViewModel">
                            <Border Margin="0,0,0,12" Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <StackPanel Spacing="8">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <CheckBox DockPanel.Dock="Right" Content="Pinned" IsChecked="{Binding Pinned, Mode=TwoWay}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource Token.Danger.Default}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Discard" Command="{Binding DiscardCommand}" Padding="10,4" />
                                        <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:DraftableStringRowViewModel">
                            <Border Margin="0,0,0,12" Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <StackPanel Spacing="8">
                                    <DockPanel>
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="entry value" />
                                        <Button DockPanel.Dock="Right" Content="Delete"
                                                Command="{Binding DeleteCommand}"
                                                Padding="10,4" Margin="8,0,0,0" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource Token.Danger.Default}" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Discard" Command="{Binding DiscardCommand}" Padding="10,4" />
                                        <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:SuggestionEntryViewModel">
                            <Border Margin="0,0,0,12" Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Host}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Token.Text.Dim}">
                                            <Run Text="Visited " /><Run Text="{Binding VisitCount}" /><Run Text="× · mostly " /><Run Text="{Binding MostCommonBrowser}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Add rule"
                                            Command="{Binding AddRuleCommand}"
                                            Padding="10,4" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:UsageEntryViewModel">
                            <Border Margin="0,0,0,8" Padding="12,8"
                                    BorderBrush="{DynamicResource Token.Border.Default}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <Grid ColumnDefinitions="160,140,*,120" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Token.Text.Dim}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Browser}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Url}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Profile}" FontSize="11" Foreground="{DynamicResource Token.Text.Dim}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>

                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
