<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AskMeFirst.MgmtUi.ViewModels"
             x:Class="AskMeFirst.MgmtUi.Views.AreaDetailView"
             x:DataType="vm:AreaDetailViewModel"
             x:CompileBindings="True">

    <Border Padding="20"
            BorderBrush="{DynamicResource Token.Border.Default}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource Token.Surface.Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="← Back"
                        Command="{Binding BackCommand}"
                        Padding="10,4"
                        Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding Placeholder}"
                       IsVisible="{Binding !HasRows}"
                       FontSize="13"
                       Foreground="{DynamicResource Token.Text.Dim}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

            <ScrollViewer IsVisible="{Binding HasRows}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleRowViewModel">
                            <Border Margin="0,0,0,12"
                                    Padding="14,12"
                                    BorderBrush="{DynamicResource Token.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{DynamicResource Token.Surface.Elevated}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Priority" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Priority, Mode=TwoWay}" Minimum="0" Maximum="10000" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="URL regex" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UrlRegex, Mode=TwoWay}" PlaceholderText="optional" />
                                    </Grid>

                                    <TextBlock Text="{Binding LastError}"
                                               Foreground="{DynamicResource Token.Danger.Default}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Discard"
                                                Command="{Binding DiscardCommand}"
                                                Padding="10,4" />
                                        <Button Content="Save"
                                                Command="{Binding SaveCommand}"
                                                Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
