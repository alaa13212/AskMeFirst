<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AskMeFirst.MgmtUi.ViewModels"
             xmlns:v="using:AskMeFirst.MgmtUi.Views"
             x:Class="AskMeFirst.MgmtUi.Views.TreeNodeView"
             x:DataType="vm:TreeNodeViewModel"
             x:CompileBindings="True">

    <StackPanel Spacing="2">
        <DockPanel LastChildFill="True">
            <Border Width="16" Height="16"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                <TextBlock Text="▶"
                           FontSize="9"
                           Foreground="{DynamicResource Token.Text.Dim}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="→"
                    Padding="6,2"
                    Command="{Binding DrillCommand}"
                    Margin="0,0,4,0" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Children}"
                      Margin="14,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeNodeViewModel">
                    <v:TreeNodeView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
